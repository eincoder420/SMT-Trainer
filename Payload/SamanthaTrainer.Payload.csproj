<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!--
      Must match the game's runtime: Unity 2019.4.35f1, Mono, API compatibility .NET 4.x.
      mscorlib is 4.0.0.0 and the game ships no netstandard.dll, so netstandard2.0 is not
      loadable here - net472 against the game's own assemblies is the only safe target.
    -->
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SamanthaTrainer.Payload</AssemblyName>
    <RootNamespace>SamanthaTrainer.Payload</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <!-- Unity resolves everything from its own Managed folder; don't drag in NuGet facades. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>SMT-Trainer Payload</AssemblyTitle>
  </PropertyGroup>

  <!--
    The payload is compiled against the game's assemblies, which is what makes calls like
    Inventory_Script.Wear_Cloth_On_Model compile-checked instead of reflection.

    Those DLLs are copied into lib\ by Build-Trainer.ps1 on the first run, so the game only
    has to be present once. After that lib\ satisfies the build on its own and the game
    folder is not needed at all. lib\ is gitignored: it is the game's code, not ours.

    Resolution order: lib\ -> GameDir.props -> SAMANTHA_GAME_DIR.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\GameDir.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\GameDir.props')" />

  <PropertyGroup>
    <LibDir>$(MSBuildThisFileDirectory)..\lib</LibDir>
    <GameDir Condition="'$(GameDir)'==''">$(SAMANTHA_GAME_DIR)</GameDir>
    <GameManaged>$(GameDir)\Samantha_Data\Managed</GameManaged>

    <RefDir Condition="Exists('$(LibDir)\Assembly-CSharp.dll')">$(LibDir)</RefDir>
    <RefDir Condition="'$(RefDir)'==''">$(GameManaged)</RefDir>
  </PropertyGroup>

  <Target Name="VerifyRefDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RefDir)\Assembly-CSharp.dll')"
           Text="Reference assemblies not found. Run Build-Trainer.ps1 once with the game installed - it finds the game, copies what it needs into lib\, and later builds need nothing else." />
  </Target>

  <ItemGroup>
    <Reference Include="mscorlib"                        HintPath="$(RefDir)\mscorlib.dll" />
    <Reference Include="System"                          HintPath="$(RefDir)\System.dll" />
    <Reference Include="System.Core"                     HintPath="$(RefDir)\System.Core.dll" />
    <Reference Include="System.Xml"                      HintPath="$(RefDir)\System.Xml.dll" />
    <Reference Include="UnityEngine"                     HintPath="$(RefDir)\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule"          HintPath="$(RefDir)\UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.IMGUIModule"         HintPath="$(RefDir)\UnityEngine.IMGUIModule.dll" />
    <Reference Include="UnityEngine.InputLegacyModule"   HintPath="$(RefDir)\UnityEngine.InputLegacyModule.dll" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(RefDir)\UnityEngine.TextRenderingModule.dll" />
    <Reference Include="UnityEngine.UI"                  HintPath="$(RefDir)\UnityEngine.UI.dll" />
    <Reference Include="UnityEngine.UIModule"            HintPath="$(RefDir)\UnityEngine.UIModule.dll" />
    <Reference Include="UnityEngine.PhysicsModule"       HintPath="$(RefDir)\UnityEngine.PhysicsModule.dll" />
    <Reference Include="UnityEngine.AnimationModule"     HintPath="$(RefDir)\UnityEngine.AnimationModule.dll" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(RefDir)\UnityEngine.ImageConversionModule.dll" />
    <Reference Include="Assembly-CSharp"                 HintPath="$(RefDir)\Assembly-CSharp.dll" />
    <Reference Include="Assembly-CSharp-firstpass"       HintPath="$(RefDir)\Assembly-CSharp-firstpass.dll" />
    <Reference Include="Newtonsoft.Json"                 HintPath="$(RefDir)\Newtonsoft.Json.dll" />
  </ItemGroup>

  <ItemGroup>
    <Reference Update="@(Reference)">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
